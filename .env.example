# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical site URL (used for metadata, sitemap, OG images). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://unmappedlabs.in

# Contact form — https://resend.com/api-keys
# Without this the form stays honest: it tells visitors it isn't connected yet.
RESEND_API_KEY=

# Where contact messages are delivered (defaults to contact@unmappedlabs.in).
CONTACT_TO_EMAIL=contact@unmappedlabs.in

# Sender — must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Unmapped Labs website <noreply@unmappedlabs.in>"
